# ==============================================================================
# CẤU HÌNH MÔI TRƯỜNG TUẦN 7+8: KIỂM THỬ GENAI (SMART LMS & GENERATIVE AI)
# Sao chép file này thành ".env" trong thư mục "week 7+8/" và điền API Key thật.
# Tuyệt đối KHÔNG commit file ".env" lên GitHub.
# ==============================================================================

GEMINI_API_KEY=your_gemini_or_vertex_express_api_key_here

# Nhà cung cấp API Gemini:
# - auto: Mặc định dùng Google AI Studio ('ai_studio', hỗ trợ cả key AIza... và AQ....)
# - ai_studio: Google AI Studio (generativelanguage.googleapis.com)
# - vertex_express: Vertex AI Express Mode (aiplatform.googleapis.com)
GEMINI_API_PROVIDER=auto

GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=MINIMAL
GEMINI_USE_RESPONSE_SCHEMA=true
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_RETRIES=2
GEMINI_MAX_JSON_RETRIES=1

# Chế độ chạy mặc định:
# - auto: Tự động dùng "live" nếu có GEMINI_API_KEY hợp lệ, ngược lại dùng "mock" offline
# - live: Bắt buộc gọi Google Gemini API
# - mock: Chạy hoàn toàn offline bằng ngân hàng câu hỏi mô phỏng chuẩn IT1108
GENAI_MODE=auto
